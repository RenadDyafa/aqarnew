# Copy to .env.local (never commit it) and fill in.

# Anthropic API key for the website assistant (/api/assistant). Server-side only.
ANTHROPIC_API_KEY=

# Where enquiries from the contact forms are forwarded (CRM, Make/Zapier, email relay).
CONTACT_WEBHOOK_URL=

# Public site URL, used in the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://aqardyafa.com

